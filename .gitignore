# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# Editor / agent local state
.idea/
.vscode/
.claude/
*.code-workspace

# Logs / temp
*.log
.tmp/
tmp/

# Anything secret-shaped (catch-all)
*.env
.env*

# Node (the project itself has no build, but agents may install tools)
node_modules/
.npm/
.pnpm-store/
.yarn/

# Wrangler local state (also gitignored inside worker/, doubled here because
# worker/wrangler.toml uses [assets] directory = "../" which writes .wrangler
# at repo root during dev)
.wrangler/
worker/.wrangler/
worker/.dev.vars
worker/.dev.vars.*

# Local serve / dev artifacts
.cache/
.parcel-cache/
dist/
build/
