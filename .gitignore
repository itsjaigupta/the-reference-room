# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# editor metadata (keep these local; project doesn't ship editor configs)
.idea/
.vscode/
*.code-workspace

# logs / temp
*.log
.tmp/
tmp/

# Node (the project itself has no build, but agents may install tools)
node_modules/
.npm/
.pnpm-store/
.yarn/

# wrangler local state (also gitignored inside worker/, doubled here for safety)
.wrangler/
worker/.wrangler/
worker/.dev.vars
worker/.dev.vars.*

# local serve / dev artifacts
.cache/
.parcel-cache/
dist/
build/
